#!/usr/bin/python3

import os
import sys
import glob
import struct

import osbuild.api


def main(tree, options):
    filename = options["filename"]
    dest = os.path.join(tree, filename.lstrip("/"))
    tmp = os.path.join(tree, "tmp-" + filename.lstrip("/"))
    sector_size = 512

    with open(dest, "rb") as finput, open(tmp, "wb") as foutput:
        # header can be copied without modifications
        data = finput.read(sector_size)
        header_struct = "=IIIQQQQIQQQBccccH433B"
        header = list(struct.unpack(header_struct, data))
        desc_size = header[6]

        # delete redundant grain dir
        rgd_offset = header[8]
        if rgd_offset > 0:
            header[8] = 0
            rgd_size = header[9] - rgd_offset
            # ensure GD and overhead offsets are correct
            header[9] -= rgd_size
            header[10] -= rgd_size

        # write modified header
        data = struct.pack(header_struct, *header)
        foutput.write(data)

        # embedded descriptor can be written without modification
        data = finput.read(sector_size * desc_size)
        foutput.write(data)

        # skip redundant grain directory
        if rgd_size > 0:
            finput.read(sector_size * rgd_size)

        # grain directory size is the total metadata overhead minus the
        # header and descriptor sectors that were already processed.
        gd_size = header[10] - desc_size - 1 - rgd_size
        data = finput.read(sector_size * gd_size)
        foutput.write(data)

        grain_header_struct = f"=QI"
        while True:
            data = finput.read(12)
            grain_header = list(struct.unpack(grain_header_struct, data))
            data_size = grain_header[1]
            foutput.write(data)

            # A grain header of size 0 indicates end of data, write the EOS marker and break.
            if data_size == 0:
                foutput.write(finput.read(sector_size - 12))
                break

            grain_data = finput.read(data_size)
            foutput.write(grain_data)

            # align data on sector (512 bytes)
            total_read = data_size + 12
            boundary = sector_size - (total_read % sector_size)
            if boundary < sector_size:
                d = finput.read(boundary)
                foutput.write(d)

    os.replace(tmp, dest)
    return 0


if __name__ == '__main__':
    args = osbuild.api.arguments()
    ret = main(args["tree"], args["options"])
    sys.exit(ret)
